#
# Grid settings for the live integration tests. Copy to .env and fill in;
# .env is git-ignored and must never be committed.
#
#     cp .env.example .env
#     NIOS_LIVE=1 pytest tests/integration -v
#
# The same variables configure NiosClient() itself, so anything you run from a
# checkout picks them up.

# Grid Manager URL, including scheme.
NIOS_GRID_URL=https://grid.example.com

# WAPI credentials. The live suite creates and deletes real objects, so point
# it at a lab grid, never production.
NIOS_USERNAME=admin
NIOS_PASSWORD=

# Optional. WAPI version to request; the models are calibrated against 2.14.
# NIOS_WAPI_VERSION=2.14

# Optional. Set to 0 for a lab grid with a self-signed certificate. Prefer
# pointing the SDK at the grid's CA bundle (ca_bundle=...) where you can.
# NIOS_VERIFY=1

# Optional. Set to DEBUG to log full request and response detail.
# IB_LOG_LEVEL=DEBUG
